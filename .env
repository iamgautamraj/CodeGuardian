# .env
# 1. Get this from https://console.groq.com/keys (It's free)
GROQ_API_KEY="gsk_abcdefgh"

# 2. Get this from GitHub Developer Settings -> Personal Access Tokens (Classic)
# Permissions needed: 'repo' (Full control of private repositories)
GITHUB_TOKEN="ghp_abcdefgh"

# 3. Create a random string yourself (e.g., "my_super_secret_password")
# We will use this to verify the request actually came from GitHub.
WEBHOOK_SECRET="hellopass"